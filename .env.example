# Supabase (Project Settings → API). A chave "anon"/"publishable" é pública por design:
# quem protege os dados são as regras de segurança (RLS) de supabase/schema.sql.
# Nunca coloque aqui a chave "service_role"/"secret".
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica
